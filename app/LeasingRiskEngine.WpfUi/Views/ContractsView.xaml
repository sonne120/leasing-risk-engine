<UserControl x:Class="LeasingRiskEngine.WpfUi.Views.ContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:LeasingRiskEngine.WpfUi.Converters"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <conv:PercentConverter   x:Key="PercentConverter"/>
        <conv:CurrencyConverter  x:Key="CurrencyConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ui:Card Grid.Column="0" Margin="0,0,16,0" Padding="16">
            <StackPanel>
                <ui:TextBlock Appearance="Secondary"
                              Text="Параметри договору"
                              FontTypography="Subtitle"
                              Margin="0,0,0,12"/>

                <TextBlock Text="Номер договору" Margin="0,8,0,4"/>
                <ui:TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Сума, ₴" Margin="0,12,0,4"/>
                <ui:NumberBox Value="{Binding Principal, Mode=TwoWay}"
                              Minimum="0" Maximum="100000000"
                              MaxDecimalPlaces="2"/>

                <TextBlock Text="Аванс, ₴" Margin="0,12,0,4"/>
                <ui:NumberBox Value="{Binding DownPayment, Mode=TwoWay}"
                              Minimum="0" Maximum="100000000"
                              MaxDecimalPlaces="2"/>

                <TextBlock Text="Річна ставка, %" Margin="0,12,0,4"/>
                <ui:NumberBox Value="{Binding AnnualRate,
                                              Mode=TwoWay,
                                              Converter={StaticResource PercentConverter}}"
                              Minimum="0" Maximum="100"
                              MaxDecimalPlaces="3"/>

                <TextBlock Text="Термін, місяців" Margin="0,12,0,4"/>
                <ui:NumberBox Value="{Binding TermMonths, Mode=TwoWay}"
                              Minimum="1" Maximum="600"
                              MaxDecimalPlaces="0"/>

                <TextBlock Text="Тип платежів" Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding PaymentTypes}"
                          SelectedItem="{Binding Type}"/>

                <TextBlock Text="Дата початку" Margin="0,12,0,4"/>
                <DatePicker SelectedDate="{Binding StartDate}"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <ui:Button Content="Розрахувати"
                               Appearance="Primary"
                               Command="{Binding CalculateCommand}"
                               MinWidth="120"/>
                    <ui:Button Content="Очистити"
                               Appearance="Secondary"
                               Command="{Binding ClearCommand}"
                               Margin="8,0,0,0"
                               MinWidth="100"/>
                </StackPanel>

                <ui:InfoBar Severity="Error"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            Title="Помилка"
                            Message="{Binding ErrorMessage}"
                            Margin="0,16,0,0"/>
            </StackPanel>
        </ui:Card>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Columns="3" Grid.Row="0" Margin="0,0,0,16">
                <ui:Card Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="МІСЯЧНИЙ ПЛАТІЖ"
                                      FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding MonthlyPayment,
                                                     Converter={StaticResource CurrencyConverter}}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="ВІДСОТКИ ЗА ТЕРМІН"
                                      FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding TotalInterest,
                                                     Converter={StaticResource CurrencyConverter}}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="РАЗОМ ДО СПЛАТИ"
                                      FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding TotalPayments,
                                                     Converter={StaticResource CurrencyConverter}}"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <ui:Card Grid.Row="1" Padding="0">
                <DataGrid ItemsSource="{Binding Schedule}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AlternatingRowBackground="#F7F7F7">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№"
                                            Binding="{Binding MonthNumber, Mode=OneTime}"
                                            Width="40"/>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date, Mode=OneTime, StringFormat=dd.MM.yyyy}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Платіж"
                                            Binding="{Binding Payment, Mode=OneTime,
                                                      Converter={StaticResource CurrencyConverter}}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Тіло"
                                            Binding="{Binding Principal, Mode=OneTime,
                                                      Converter={StaticResource CurrencyConverter}}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Відсотки"
                                            Binding="{Binding Interest, Mode=OneTime,
                                                      Converter={StaticResource CurrencyConverter}}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Залишок"
                                            Binding="{Binding Balance, Mode=OneTime,
                                                      Converter={StaticResource CurrencyConverter}}"
                                            Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
