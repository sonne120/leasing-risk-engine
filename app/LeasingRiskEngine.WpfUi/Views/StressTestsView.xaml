<UserControl x:Class="LeasingRiskEngine.WpfUi.Views.StressTestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:LeasingRiskEngine.WpfUi.Converters"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <conv:PercentConverter x:Key="PercentConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,16,0">
            <StackPanel>

                <ui:Card Padding="16">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Сценарій"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="Тип стрес-тесту" Margin="0,4,0,4"/>
                        <ComboBox ItemsSource="{Binding Kinds}"
                                  SelectedItem="{Binding Kind}"/>

                        <TextBlock Text="Схема інтегрування" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding Schemes}"
                                  SelectedItem="{Binding Scheme}"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,12,0,0"
                         Visibility="{Binding ShowShift,
                                              Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Hull-White parallel shift"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="a" Margin="0,4,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.A, Mode=TwoWay}"
                                      MaxDecimalPlaces="4" Minimum="0" Maximum="5"/>
                        <TextBlock Text="θ, %" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.Theta, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="0" Maximum="100"/>
                        <TextBlock Text="σ" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.Sigma, Mode=TwoWay}"
                                      MaxDecimalPlaces="5" Minimum="0" Maximum="1"/>
                        <TextBlock Text="r0, %" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.R0, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="0" Maximum="100"/>
                        <TextBlock Text="T, years" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.Expiration, Mode=TwoWay}"
                                      MaxDecimalPlaces="2" Minimum="0.1" Maximum="50"/>

                        <TextBlock Text="Shift, bps" Margin="0,16,0,4"/>
                        <ui:NumberBox Value="{Binding ShiftBps, Mode=TwoWay}"
                                      MaxDecimalPlaces="1" Minimum="-500" Maximum="500"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,12,0,0"
                         Visibility="{Binding ShowVol,
                                              Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="GBM volatility shock"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="μ, %" Margin="0,4,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.Mu, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="-50" Maximum="100"/>
                        <TextBlock Text="σ (baseline), %" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.Sigma, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="0" Maximum="200"/>
                        <TextBlock Text="S0" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.S0, Mode=TwoWay}"
                                      MaxDecimalPlaces="2" Minimum="0.01" Maximum="1000000"/>
                        <TextBlock Text="T, years" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.Expiration, Mode=TwoWay}"
                                      MaxDecimalPlaces="2" Minimum="0.1" Maximum="50"/>

                        <TextBlock Text="σ multiplier" Margin="0,16,0,4"/>
                        <ui:NumberBox Value="{Binding VolMultiplier, Mode=TwoWay}"
                                      MaxDecimalPlaces="2" Minimum="0.1" Maximum="5"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Симуляція"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="Кроків" Margin="0,4,0,4"/>
                        <ui:NumberBox Value="{Binding Steps, Mode=TwoWay}"
                                      MaxDecimalPlaces="0" Minimum="1" Maximum="10000"/>
                        <TextBlock Text="Шляхів" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Paths, Mode=TwoWay}"
                                      MaxDecimalPlaces="0" Minimum="100" Maximum="10000000"/>
                        <TextBlock Text="Воркерів (0=авто)" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Threads, Mode=TwoWay}"
                                      MaxDecimalPlaces="0" Minimum="0" Maximum="64"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <ui:Button Content="Виконати"
                                       Appearance="Primary"
                                       Command="{Binding RunCommand}"
                                       MinWidth="130"/>
                            <ui:Button Content="Очистити історію"
                                       Appearance="Secondary"
                                       Command="{Binding ClearCommand}"
                                       Margin="8,0,0,0"
                                       MinWidth="140"/>
                        </StackPanel>

                        <ui:InfoBar Severity="Error"
                                    IsOpen="{Binding HasError, Mode=OneWay}"
                                    Title="Помилка"
                                    Message="{Binding ErrorMessage}"
                                    Margin="0,16,0,0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <ui:Card Grid.Column="1" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      AlternatingRowBackground="#F7F7F7">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Час"
                                        Binding="{Binding Timestamp, Mode=OneTime, StringFormat=HH:mm:ss}"
                                        Width="80"/>
                    <DataGridTextColumn Header="Сценарій"
                                        Binding="{Binding Scenario, Mode=OneTime}"
                                        Width="220"/>
                    <DataGridTextColumn Header="Baseline"
                                        Binding="{Binding BaselineMean, Mode=OneTime, StringFormat='{}{0:F6}'}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Shifted"
                                        Binding="{Binding ShiftedMean, Mode=OneTime, StringFormat='{}{0:F6}'}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Δ"
                                        Binding="{Binding Delta, Mode=OneTime, StringFormat='{}{0:+#.######;-#.######;0}'}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Δ %"
                                        Binding="{Binding DeltaPercent, Mode=OneTime, StringFormat='{}{0:+0.00;-0.00;0.00} %'}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>
    </Grid>
</UserControl>
