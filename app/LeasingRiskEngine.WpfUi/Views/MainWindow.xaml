<ui:FluentWindow x:Class="LeasingRiskEngine.WpfUi.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:prism="http://prismlibrary.com/"
                 prism:ViewModelLocator.AutoWireViewModel="True"
                 Title="Leasing — Quantitative Workbench"
                 Width="1280" Height="820"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Leasing — Quantitative Workbench"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Договори"
                                       Tag="ContractsView"
                                       Icon="{ui:SymbolIcon Symbol=DocumentText24}"/>
                <ui:NavigationViewItem Content="Monte Carlo"
                                       Tag="MonteCarloView"
                                       Icon="{ui:SymbolIcon Symbol=Flash24}"/>
                <ui:NavigationViewItem Content="Ризик-метрики"
                                       Tag="RiskDashboardView"
                                       Icon="{ui:SymbolIcon Symbol=DataHistogram24}"/>
                <ui:NavigationViewItem Content="Стрес-тести"
                                       Tag="StressTestsView"
                                       Icon="{ui:SymbolIcon Symbol=WarningShield24}"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.ContentOverlay>
                <ContentControl prism:RegionManager.RegionName="ContentRegion"
                                Margin="16"/>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding NativeCoreInfo}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentTime, StringFormat='{}{0:HH:mm:ss}'}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
