<UserControl x:Class="LeasingRiskEngine.WpfUi.Views.RiskDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:LeasingRiskEngine.WpfUi.Converters"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <conv:PercentConverter x:Key="PercentConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,16,0">
            <StackPanel>

                <ui:Card Padding="16">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Профіль втрат"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="Тип втрати" Margin="0,4,0,4"/>
                        <ComboBox ItemsSource="{Binding LossKinds}"
                                  SelectedItem="{Binding SelectedLoss}"/>

                        <TextBlock Text="Схема інтегрування" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding Schemes}"
                                  SelectedItem="{Binding Scheme}"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,12,0,0"
                         Visibility="{Binding ShowHullWhite,
                                              Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Hull-White (loss = −P(0,T))"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="a" Margin="0,4,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.A, Mode=TwoWay}"
                                      MaxDecimalPlaces="4" Minimum="0" Maximum="5"/>
                        <TextBlock Text="θ, %" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.Theta, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="0" Maximum="100"/>
                        <TextBlock Text="σ" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.Sigma, Mode=TwoWay}"
                                      MaxDecimalPlaces="5" Minimum="0" Maximum="1"/>
                        <TextBlock Text="r0, %" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.R0, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="0" Maximum="100"/>
                        <TextBlock Text="T, years" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding HullWhite.Expiration, Mode=TwoWay}"
                                      MaxDecimalPlaces="2" Minimum="0.1" Maximum="50"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,12,0,0"
                         Visibility="{Binding ShowGbm,
                                              Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="GBM (loss = S0 − S(T))"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="μ, %" Margin="0,4,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.Mu, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="-50" Maximum="100"/>
                        <TextBlock Text="σ, %" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.Sigma, Mode=TwoWay,
                                                      Converter={StaticResource PercentConverter}}"
                                      MaxDecimalPlaces="3" Minimum="0" Maximum="200"/>
                        <TextBlock Text="S0" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.S0, Mode=TwoWay}"
                                      MaxDecimalPlaces="2" Minimum="0.01" Maximum="1000000"/>
                        <TextBlock Text="T, years" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Gbm.Expiration, Mode=TwoWay}"
                                      MaxDecimalPlaces="2" Minimum="0.1" Maximum="50"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Симуляція"
                                      FontTypography="Subtitle"
                                      Margin="0,0,0,12"/>

                        <TextBlock Text="Кроків" Margin="0,4,0,4"/>
                        <ui:NumberBox Value="{Binding Steps, Mode=TwoWay}"
                                      MaxDecimalPlaces="0" Minimum="1" Maximum="10000"/>
                        <TextBlock Text="Шляхів" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Paths, Mode=TwoWay}"
                                      MaxDecimalPlaces="0" Minimum="100" Maximum="10000000"/>
                        <TextBlock Text="Воркерів (0=авто)" Margin="0,12,0,4"/>
                        <ui:NumberBox Value="{Binding Threads, Mode=TwoWay}"
                                      MaxDecimalPlaces="0" Minimum="0" Maximum="64"/>

                        <ui:Button Content="Обчислити ризик"
                                   Appearance="Primary"
                                   Command="{Binding ComputeCommand}"
                                   Margin="0,20,0,0"
                                   HorizontalAlignment="Stretch"/>

                        <ui:InfoBar Severity="Error"
                                    IsOpen="{Binding HasError, Mode=OneWay}"
                                    Title="Помилка"
                                    Message="{Binding ErrorMessage}"
                                    Margin="0,16,0,0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                <ui:Card Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="VaR 95%" FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding Result.Var95, StringFormat='{}{0:F6}'}"
                                      Foreground="#D85A30"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="CVaR 95% (Expected Shortfall)"
                                      FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding Result.Cvar95, StringFormat='{}{0:F6}'}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Worst case" FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding Result.WorstCase, StringFormat='{}{0:F6}'}"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                <ui:Card Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="VaR 99%" FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding Result.Var99, StringFormat='{}{0:F6}'}"
                                      Foreground="#A32D2D"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="CVaR 99%"
                                      FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding Result.Cvar99, StringFormat='{}{0:F6}'}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16">
                    <StackPanel>
                        <ui:TextBlock Appearance="Secondary"
                                      Text="Mean" FontSize="11"/>
                        <ui:TextBlock FontTypography="Title"
                                      Text="{Binding Result.Mean, StringFormat='{}{0:F6}'}"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <ui:Card Grid.Row="2" Padding="8">
                <lvc:CartesianChart Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    Sections="{Binding Sections}"
                                    LegendPosition="Top"
                                    ZoomMode="X"/>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
