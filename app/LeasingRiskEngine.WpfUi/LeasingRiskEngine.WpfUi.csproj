<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>leasing-risk-engine</AssemblyName>
    <RootNamespace>LeasingRiskEngine.WpfUi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />

    <PackageReference Include="WPF-UI" Version="3.0.5" />

    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />

    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF"
                      Version="2.0.0-rc5.4" />
  </ItemGroup>

  <ItemGroup>

    <Reference Include="LeasingBridge">
      <HintPath>..\..\build-win\bridge\$(Configuration)\LeasingBridge.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Customers, contracts and run history (EF Core: SQL Server or SQLite). -->
    <ProjectReference Include="..\LeasingRiskEngine.Data\LeasingRiskEngine.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Database provider and connection string, read at startup. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy native DLL next to the exe.-->
  <Target Name="CopyBridgeDll" AfterTargets="Build"
          Condition="Exists('..\..\build-win\bridge\$(Configuration)\LeasingBridge.dll')">
    <Copy SourceFiles="..\..\build-win\bridge\$(Configuration)\LeasingBridge.dll"
          DestinationFolder="$(OutDir)" />
  </Target>

</Project>
